{
  "project": {
    "name": "hawk",
    "displayName": "Hawk",
    "namespace": "staticcanvas",
    "path": "staticcanvas/hawk",
    "artifactPath": "staticcanvas/hawk",
    "defaultBranch": "main",
    "npmPackage": "@staticcanvas/hawk",
    "jsrPackage": "@staticcanvas/hawk",
    "bannerUrl": "https://r2os.staticcanvas.me/logos/hawk/dist/webp/hawk-banner-128x51.webp",
    "documentationUrl": "https://staticcanvas.gitlab.io/hawk"
  },
  "readmeHeader": {
    "alignment": "left",
    "badgeStyle": "flat-square",
    "badgeColor": "#2C3E50",
    "labelColor": "#2C3E50",
    "logoColor": "#4CA1AF",
    "codecovToken": ""
  },
  "readme": {
    "requiredHeadings": [
      { "level": 2, "name": "Overview" },
      { "level": 2, "name": "Features" },
      { "level": 2, "name": "Installation" },
      { "level": 2, "name": "Usage" },
      { "level": 2, "name": "Theming" },
      { "level": 2, "name": "Animation Drivers" },
      { "level": 2, "name": "API Reference" },
      { "level": 2, "name": "Development & NPM Scripts" }
    ]
  },
  "commit": {
    "defaultType": "feat",
    "defaultScope": "core",
    "defaultDescription": "update search engine",
    "types": [
      { "name": "feat", "description": "add or change user-facing behavior" },
      { "name": "fix", "description": "correct defective behavior" },
      { "name": "docs", "description": "change documentation only" },
      { "name": "refactor", "description": "restructure without behavior changes" },
      { "name": "perf", "description": "improve runtime performance" },
      { "name": "test", "description": "add or correct tests" },
      { "name": "build", "description": "change build or dependencies" },
      { "name": "ci", "description": "change continuous integration" },
      { "name": "chore", "description": "perform repository maintenance" },
      { "name": "revert", "description": "revert an earlier commit" }
    ],
    "scopes": [
      {
        "name": "rivet",
        "description": "repository metadata automation",
        "paths": ["rivet.ps1", ".rivet/**"]
      },
      {
        "name": "core",
        "description": "search engine, DOM/keyboard/preview logic, layout params",
        "paths": [
          "src/hawk.js",
          "src/hawk.d.ts",
          "src/hawk.css",
          "tests/**",
          "vite*.js",
          "bunfig.toml"
        ]
      },
      {
        "name": "theme",
        "description": "theme plugin system and the default typeflow theme",
        "paths": ["src/hawk-theme-*.js", "src/hawk-theme-*.d.ts", "src/hawk-theme-*.css"]
      },
      {
        "name": "animation",
        "description": "animation driver plugin system and drivers",
        "paths": ["src/hawk-animation-*.js", "src/hawk-animation-*.d.ts"]
      },
      {
        "name": "pagefind",
        "description": "Pagefind indexing integration and recipes",
        "paths": ["scripts/pagefind-index.mjs"]
      },
      {
        "name": "docs",
        "description": "documentation site, guides, and architecture notes",
        "paths": [
          "docs/**",
          "public/**",
          "editors/**",
          "branding/**",
          "architecture/**",
          "README*.md"
        ]
      },
      {
        "name": "release",
        "description": "versioning and release assets",
        "paths": [
          "CHANGELOG.md",
          "release-notes.md",
          "package*.json",
          "bun.lock",
          "jsr.jsonc",
          "scripts/**",
          "docs/data/changelog.json",
          "README*.md"
        ]
      },
      {
        "name": "ci",
        "description": "pipeline configuration and quality gates",
        "paths": [".gitlab-ci.yml", "ci-failures.md"]
      },
      { "name": "none", "description": "omit the commit scope", "paths": ["**"] }
    ],
    "preview": {
      "maxDiffLines": 240
    }
  },
  "authors": {
    "mappings": []
  },
  "tagging": {
    "prefix": "v",
    "releaseSuffix": "-release",
    "remote": "origin"
  },
  "gitlab": {
    "baseUri": "https://gitlab.com",
    "projectId": "",
    "tokenEnvironmentVariable": "GITLAB_API_KEY"
  },
  "metadataSource": "repo_meta.json",
  "labelScope": "project",
  "defaultTextColor": "#FFFFFF",
  "requestTimeoutSeconds": 30
}
