{
  "name": "@staticcanvas/hawk",
  "version": "0.43.0",
  "description": "Themeable, pluggable command-palette search for static sites. Pagefind-powered indexing, swappable reveal animations (a TypeFlow typewriter driver ships built-in), swappable visual themes.",
  "type": "module",
  "main": "./dist/hawk.cjs",
  "module": "./dist/hawk.mjs",
  "browser": "./dist/hawk.js",
  "types": "./src/hawk.d.ts",
  "exports": {
    ".": {
      "types": "./src/hawk.d.ts",
      "import": "./dist/hawk.mjs",
      "require": "./dist/hawk.cjs",
      "default": "./dist/hawk.js"
    },
    "./css": "./src/hawk.css",
    "./theme-typeflow": {
      "types": "./src/hawk-theme-typeflow.d.ts",
      "import": "./dist/hawk-theme-typeflow.mjs",
      "require": "./dist/hawk-theme-typeflow.cjs",
      "default": "./dist/hawk-theme-typeflow.js"
    },
    "./theme-typeflow/css": "./src/hawk-theme-typeflow.css",
    "./animation-typeflow": {
      "types": "./src/hawk-animation-typeflow.d.ts",
      "import": "./dist/hawk-animation-typeflow.mjs",
      "require": "./dist/hawk-animation-typeflow.cjs",
      "default": "./dist/hawk-animation-typeflow.js"
    },
    "./debug": {
      "types": "./src/hawk-debug.d.ts",
      "import": "./dist/hawk-debug.mjs",
      "require": "./dist/hawk-debug.cjs",
      "default": "./dist/hawk-debug.js"
    },
    "./metrics": {
      "types": "./src/hawk-metrics.d.ts",
      "import": "./dist/hawk-metrics.mjs",
      "require": "./dist/hawk-metrics.cjs",
      "default": "./dist/hawk-metrics.js"
    },
    "./icons": {
      "types": "./src/hawk-icons.d.ts",
      "import": "./src/hawk-icons.js",
      "default": "./src/hawk-icons.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "branding",
    "README.md",
    "LICENSE",
    "jsr.jsonc"
  ],
  "scripts": {
    "dev": "vite",
    "serve:demo": "vite --open docs/static/webutil/index.html",
    "docs:build": "npm run build && node scripts/compile-docs-scss.mjs && node scripts/generate-theme-css.mjs && hugo --source docs && node scripts/pagefind-index.mjs --site public",
    "docs:serve": "npm run build && node scripts/compile-docs-scss.mjs && node scripts/generate-theme-css.mjs && hugo --source docs && node scripts/pagefind-index.mjs --site public && hugo server --source docs --buildDrafts --disableFastRender --ignoreCache --noHTTPCache --gc",
    "build": "vite build && npm_config_mode=theme-typeflow vite build --config vite.optional.config.js && npm_config_mode=animation-typeflow vite build --config vite.optional.config.js && npm_config_mode=debug vite build --config vite.optional.config.js && npm_config_mode=metrics vite build --config vite.optional.config.js",
    "dev:typeflow": "npm run build && node scripts/copy-to-typeflow.mjs",
    "pagefind:index": "node scripts/pagefind-index.mjs",
    "themes:css": "node scripts/generate-theme-css.mjs",
    "docs:scss": "node scripts/compile-docs-scss.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:bun": "bun test tests/*.test.js",
    "test:coverage:bun": "bun test --coverage tests/*.test.js",
    "test:e2e": "npm run build && hugo --source docs --destination ../public-e2e --baseURL http://localhost:4174/public-e2e/ && node scripts/pagefind-index.mjs --site public-e2e && playwright test",
    "check:size": "node scripts/check-bundle-size.mjs",
    "validate:release": "node scripts/validate-release.mjs",
    "check:quality": "npm run build && npm run check:size && npm test",
    "bench:size": "node scripts/compare-bundle-size.mjs"
  },
  "keywords": [
    "search",
    "command-palette",
    "pagefind",
    "static-site",
    "ui-component",
    "vanilla-js",
    "themeable",
    "staticcanvas",
    "esm"
  ],
  "author": "Garvey K. Snow",
  "license": "MIT",
  "dependencies": {
    "pagefind": "^1.5.2"
  },
  "peerDependencies": {
    "@staticcanvas/logcad": "^0.6.0",
    "@staticcanvas/typeflow": "^0.34.1"
  },
  "peerDependenciesMeta": {
    "@staticcanvas/typeflow": {
      "optional": true
    },
    "@staticcanvas/logcad": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/staticcanvas/hawk.git"
  },
  "homepage": "https://staticcanvas.gitlab.io/hawk",
  "bugs": {
    "url": "https://gitlab.com/staticcanvas/hawk/-/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@simonwep/pickr": "1.10.1",
    "@staticcanvas/logcad": "^0.6.0",
    "@staticcanvas/lume": "^0.37.1",
    "@staticcanvas/typeflow": "^0.34.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.0",
    "rollup-plugin-copy": "^3.5.0",
    "sass": "^1.104.1",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
