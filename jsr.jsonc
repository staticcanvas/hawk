{
  // URL to the schema. This gives you autocompletion and validation in VS Code.
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  // ---------------------------------------------------------
  // PACKAGE IDENTITY
  // ---------------------------------------------------------
  // The name must be scoped with an '@' (e.g. @username/pkgname)
  "name": "@staticcanvas/hawk",
  // Must be a valid SemVer version (e.g. 0.1.0, 1.0.0-rc.1)
  "version": "0.43.5",
  // ---------------------------------------------------------
  // EXPORTS
  // ---------------------------------------------------------
  // Defines what files users can import.
  // "." is the default import (e.g. import { HawkSearch } from "@staticcanvas/hawk")
  "exports": {
    ".": "./src/hawk.js",
    "./animation-typeflow": "./src/hawk-animation-typeflow-jsr.js",
    "./debug": "./src/hawk-debug-jsr.js",
    "./icons": "./src/hawk-icons.js",
    "./metrics": "./src/hawk-metrics.js",
    "./theme-typeflow": "./src/hawk-theme-typeflow.js",
  },
  // ---------------------------------------------------------
  // PUBLISHING CONTROLS
  // ---------------------------------------------------------
  // Controls which files are uploaded to JSR.
  "publish": {
    "include": ["src/**", "package.json", "README.md", "LICENSE"],
    "exclude": ["src/**/*.test.js", "src/hawk-animation-typeflow.js", "src/hawk-debug.js"],
  },
}
